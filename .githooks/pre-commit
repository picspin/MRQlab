#!/usr/bin/env bash
# MRQlab pre-commit gate.
#
# Enable once per clone:  git config core.hooksPath .githooks
#
# It is intentionally fast and deterministic: it runs only the checks the
# staged diff actually triggers (via tools/validation/diff_checklist.py), so an
# unrelated change is not slowed down. Set MRQLAB_SKIP_PRECOMMIT=1 to bypass.
#
# End-to-end smoke: tests/local_agent/test_precommit_hook.py drives this script
# against a throwaway repository and asserts both the block and the pass paths.
set -euo pipefail

if [ "${MRQLAB_SKIP_PRECOMMIT:-0}" = "1" ]; then
    echo "pre-commit: skipped (MRQLAB_SKIP_PRECOMMIT=1)"
    exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Resolve an interpreter that actually has the project's dependencies. In a git
# worktree `$ROOT/.venv` does not exist (the venv lives in the main checkout), so
# fall back to the main worktree's venv before the bare system python.
MAIN_ROOT="$(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2; exit}')"
resolve_py() {
    for candidate in \
        "${MRQLAB_PYTHON:-}" \
        "$ROOT/.venv/bin/python" \
        "${MAIN_ROOT:+$MAIN_ROOT/.venv/bin/python}"; do
        [ -n "$candidate" ] && [ -x "$candidate" ] && { echo "$candidate"; return 0; }
    done
    command -v python3
}
PY="$(resolve_py)"
# A gate that cannot run its checks must block, not pass: require pytest here.
if ! "$PY" -c "import pytest" >/dev/null 2>&1; then
    echo "pre-commit: no interpreter with pytest (tried MRQLAB_PYTHON, \$ROOT/.venv, ${MAIN_ROOT:-main}/.venv); set MRQLAB_PYTHON" >&2
    exit 1
fi

# Packages must resolve from this worktree, not the venv's editable checkout.
export PYTHONPATH="packages/sequence-ir:packages/physics:packages/recon:packages/mrqlab_experiment:services/api:services/local_agent${PYTHONPATH:+:$PYTHONPATH}"

staged=$(git diff --cached --name-only)
[ -z "$staged" ] && exit 0

# 1. Which validation surfaces does the staged diff touch?
echo "pre-commit: diff-triggered validation checklist"
"$PY" tools/validation/diff_checklist.py --staged --check || exit 1

# 2. If a lease/licensing surface changed, run its focused suite + shadow walk.
if echo "$staged" | grep -q '^services/local_agent/mrqlab_agent/'; then
    echo "pre-commit: lease surface -> focused tests + shadow walk-through"
    "$PY" -m pytest tests/local_agent -q -p no:cacheprovider || exit 1
    "$PY" tools/validation/shadow_walkthrough.py || exit 1
fi

echo "pre-commit: OK"
